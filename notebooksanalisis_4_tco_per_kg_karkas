at = stg[stg.kategori == \"Obat & Vitamin\"]\n","POOL = dict(\n","    pakan=float((feed.nilai_wajar + ppn_add(feed)).sum()),\n","    obat=float((obat.nilai_wajar + ppn_add(obat)).sum()),\n","    selisih_lain=float(stg[stg.kategori != \"Bakalan Sapi\"].selisih_faktur.sum()),\n",")\n","print(f\"Ekor bakalan diterima : {bak.ekor_gr.sum():.0f}\")\n","print(f\"Belanja pakan (wajar) : Rp {POOL['pakan']:,.0f}\")\n","print(f\"Belanja obat (wajar)  : Rp {POOL['obat']:,.0f}\")\n","print(f\"Selisih faktur non-bakalan: Rp {POOL['selisih_lain']:,.0f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"mOPhiyhqcmia","executionInfo":{"status":"ok","timestamp":1793542238893,"user_tz":-420,"elapsed":38,"user":{"displayName":"Salwa Nurisanti Maulidina","userId":"03139720787536434120"}},"outputId":"c53c8c77-e32b-4b21-e75f-2156e492f188"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Ekor bakalan diterima : 167\n","Belanja pakan (wajar) : Rp 312,002,558\n","Belanja obat (wajar)  : Rp 16,768,375\n","Selisih faktur non-bakalan: Rp 70,153,930\n"]}]},{"cell_type":"markdown","source":["6. Mesin perhitungan TCO"],"metadata":{"id":"R-s2H6nGcv5K"}},{"cell_type":"code","source":["# 7. Fungsi inti\n","COMP = [\"bakalan\", \"pakan\", \"obat\", \"kandang\", \"angkut_potong\", \"bunga\", \"kebocoran\"]\n","LABEL = {\"bakalan\": \"Harga bakalan\", \"pakan\": \"Pakan\", \"obat\": \"Obat & vitamin\",\n","         \"kandang\": \"Kandang & tenaga kerja\", \"angkut_potong\": \"Angkut & potong\",\n","         \"bunga\": \"Bunga modal\", \"kebocoran\": \"Kebocoran faktur\"}\n","\n","def grp(keys):\n","    g = bak.groupby(keys).agg(ekor=(\"ekor_gr\", \"sum\"), kg=(\"qty_gr\", \"sum\"),\n","                              beli=(\"nilai_wajar\", \"sum\"), selisih=(\"selisih_faktur\", \"sum\"),\n","                              tx=(\"terms_x_ekor\", \"sum\")).reset_index()\n","    g[\"terms\"] = g.tx / g.ekor\n","    return g\n","\n","def run(keys=(\"item_id\",), sc=None, g_override=None):\n","    \"\"\"Hitung TCO per ekor dan per kg karkas untuk kelompok `keys`. sc = faktor skala sensitivitas.\"\"\"\n","    s = {\"beli\": 1, \"pakan\": 1, \"adg\": 1, \"rend\": 1, \"H\": 1, \"lain\": 1, \"mort\": 1, **(sc or {})}\n","    Gp = {**G, **(g_override or {})}\n","    H = Gp[\"H\"] * s[\"H\"]\n","    adg = BREED.adg * s[\"adg\"]\n","    rend = (BREED.rend * s[\"rend\"]).clip(upper=0.70)\n","\n","    # --- tarif pakan & obat dari data ---\n","    n = np.minimum(H, bak.hari_di_kandang).clip(lower=0)\n","    a = bak.item_id.map(adg)\n","    bw_hari = (bak.ekor_gr * ((bak.qty_gr / bak.ekor_gr) * n + a * n * (n - 1) / 2)).sum()\n","    ekor_hari = (bak.ekor_gr * n).sum()\n","    r_pakan = POOL[\"pakan\"] * s[\"pakan\"] / bw_hari\n","    r_obat = POOL[\"obat\"] / ekor_hari\n","    r_sel = POOL[\"selisih_lain\"] / bw_hari\n","\n","    g = grp(list(keys))\n","    br = g.item_id\n","    bw0 = g.kg / g.ekor\n","    a_g, rend_g = br.map(adg), br.map(rend)\n","    cyc = bw0 * H + a_g * H * (H - 1) / 2                      # bobot-hari satu siklus per ekor\n","\n","    out = g.copy()\n","    out[\"bw0\"] = bw0\n","    out[\"bakalan\"] = g.beli * s[\"beli\"] / g.ekor\n","    out[\"pakan\"] = r_pakan * cyc\n","    out[\"obat\"] = r_obat * H\n","    out[\"kandang\"] = Gp[\"kandang_ekor_hari\"] * H * s[\"lain\"]\n","    out[\"angkut_potong\"] = (Gp[\"angkut_masuk_ekor\"] + Gp[\"potong_ekor\"]) * s[\"lain\"]\n","    modal = out.bakalan + Gp[\"angkut_masuk_ekor\"] * s[\"lain\"]\n","    out[\"bunga\"] = Gp[\"bunga_tahun\"] * modal * np.maximum(H - g.terms, 0) / 365\n","    out[\"kebocoran\"] = g.selisih * s[\"beli\"] / g.ekor + r_sel * cyc\n","    out[\"total_ekor\"] = out[COMP].sum(axis=1)\n","    out[\"bw_akhir\"] = bw0 + a_g * H\n","    out[\"karkas_kg\"] = out.bw_akhir * rend_g * (1 - Gp[\"mortalitas\"] * s[\"mort\"])\n","    out[\"tco_kg\"] = out.total_ekor / out.karkas_kg\n","    for c in COMP:\n","        out[c + \"_kg\"] = out[c] / out.karkas_kg\n","    out[\"margin_kg\"] = Gp[\"harga_jual_karkas\"] - out.tco_kg\n","    out[\"margin_ekor\"] = out.margin_kg * out.karkas_kg\n","    return out\n","\n","def portfolio(t):\n","    \"\"\"TCO per kg karkas gabungan, dibobot jumlah ekor\"\"\"\n","    return (t.total_ekor * t.ekor).sum() / (t.karkas_kg * t.ekor).sum()\n","\n","base = run((\"item_id\",))\n","print(f\"TCO gabungan semua bakalan: Rp {portfolio(base):,.0f} per kg karkas\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uVhUGWd1crB6","executionInfo":{"status":"ok","timestamp":1793542267936,"user_tz":-420,"elapsed":91,"user":{"displayName":"Salwa Nurisanti Maulidina","userId":"03139720787536434120"}},"outputId":"4638a716-268c-45af-8cec-6c166ca1589e"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["TCO gabungan semua bakalan: Rp 114,953 per kg karkas\n"]}]},{"cell_type":"markdown","source":["7. Hasil per jenis bakalan"],"metadata":{"id":"duI3swZrc1hp"}},{"cell_type":"code","source":["# 8. Tabel hasil per jenis\n","res_breed = base.merge(BREED[[\"jenis\"]], left_on=\"item_id\", right_index=True).set_index(\"jenis\")\n","res_breed[\"tco_bersih_kg\"] = res_breed.tco_kg - res_breed.kebocoran_kg      # tanpa kebocoran faktur\n","view = res_breed[[\"ekor\", \"bw0\", \"bw_akhir\", \"karkas_kg\", \"total_ekor\", \"tco_kg\", \"tco_bersih_kg\", \"margin_kg\"]].copy()\n","view.columns = [\"Ekor\", \"Bobot masuk (kg)\", \"Bobot akhir (kg)\", \"Karkas/ekor (kg)\", \"Biaya/ekor (Rp)\",\n","                \"TCO/kg karkas (Rp)\", \"TCO tanpa kebocoran (Rp)\", \"Margin/kg (Rp)\"]\n","display(view.sort_values(\"TCO/kg karkas (Rp)\").round(0))\n","print(\"Catatan: jenis dengan sedikit ekor (mis. PO) sangat mudah bergeser oleh satu faktur bermasalah. \"\n","      \"Bandingkan kolom TCO dengan dan tanpa kebocoran.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":290},"id":"M9LvhUilcyIb","executionInfo":{"status":"ok","timestamp":1793542290843,"user